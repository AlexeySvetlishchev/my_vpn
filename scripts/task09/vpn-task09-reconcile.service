[Unit]
Description=TASK 09 reconcile owned AmneziaWG client peers
Requires=vpn-task07-client.service
After=vpn-task07-client.service
ConditionPathExists=/etc/vpn-task09/activation.json

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 -I -B /opt/vpn-task09/vpnctl.py --json reconcile
TimeoutStartSec=30s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/vpn-task09 /run/vpn-task09 /run/vpn-task07
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN
StandardOutput=journal
StandardError=journal
