[Unit]
Description=TASK 06 read-only transport health check
Requires=vpn-task06-awg.service vpn-task06-probe.service
After=vpn-task06-awg.service vpn-task06-probe.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/vpn-task06 monitor
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/vpn-task06
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
StandardOutput=journal
StandardError=journal
