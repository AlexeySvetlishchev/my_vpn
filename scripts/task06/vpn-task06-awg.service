[Unit]
Description=TASK 06 isolated userspace AmneziaWG transport
Wants=network-online.target
Wants=vpn-task06-probe.service
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root
UMask=0077
RuntimeDirectory=vpn-task06
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
ExecStart=/usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C /usr/bin/python3 -I -B /opt/vpn-task06/helper.py serve
ExecStartPost=/usr/local/sbin/vpn-task06 wait-ready
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=15s
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/vpn-task06 /etc/vpn-task06 /var/lib/vpn-task06
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
