[Unit]
Description=TASK 08 restore isolated FR client egress rules
Requires=vpn-task06-awg.service
After=network-online.target vpn-task06-awg.service
ConditionPathExists=/var/lib/vpn-task08/active.json

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 -I -B /opt/vpn-task08/recover.py fr
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/vpn-task08
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
StandardOutput=journal
StandardError=journal
